# ============================================================
#  Mangoo Connect+ — variables d'environnement (exemple)
#  ------------------------------------------------------------
#  Copiez ce fichier en `.env` puis adaptez les valeurs :
#      copy .env.example .env        (Windows)
#      cp   .env.example .env        (Linux/macOS)
#  Le serveur charge `.env` au démarrage (voir server.cjs).
#
#  Règles de formatage du fichier :
#   - UNE variable par ligne, au format CLE=valeur
#   - Pas de commentaire en fin de ligne (le parseur ne les gère pas)
#   - Les guillemets simples/doubles autour de la valeur sont retirés
#   - Une variable déjà présente dans l'environnement n'est PAS écrasée
# ============================================================

# --- Ports ---------------------------------------------------
# Port HTTP (pages publiques + signalisation WebRTC)
PORT=8080

# Port HTTPS (obligatoire pour l'espace admin si certs présents)
HTTPS_PORT=8443

# --- Compte administrateur initial ---------------------------
# E-mail de connexion au tableau de bord d'administration
ADMIN_EMAIL=admin@mangootech.com

# Mot de passe admin. En développement, LAISSER VIDE pour qu'un secret
# fort soit généré aléatoirement et affiché une seule fois au démarrage.
# EN PRODUCTION (NODE_ENV=production), cette valeur est OBLIGATOIRE :
# le serveur refuse de démarrer si elle manque (aucun secret n'est
# généré ni écrit sur disque). Ex. : ADMIN_PASSWORD=ChangezMoi-EnProduction
ADMIN_PASSWORD=

# PIN admin à 4 chiffres. En développement, vide = génération aléatoire
# (affiché une fois). EN PRODUCTION, OBLIGATOIRE (fourni par Render).
ADMIN_PIN=

# --- Sécurité -------------------------------------------------
# Forcer le HTTPS sur l'espace admin (true par défaut).
# - true  : API admin en HTTP -> 426, pages admin en HTTP -> 301
# - false : désactiver le forçage (uniquement si un reverse proxy
#           en amont termine déjà le TLS et fait respecter HTTPS)
FORCE_HTTPS_ADMIN=true

# --- Persistance des données ----------------------------------
# Répertoire où sont stockés les fichiers JSON (utilisateurs,
# sessions, transactions, portefeuilles, livreurs, livraisons…).
# - Local (développement) : laisser vide -> ./data
# - Render (Persistent Disk) : DATA_DIR=/app/data
DATA_DIR=

# --- Sauvegarde des données -----------------------------------
# Sauvegarde locale automatique (voir backup-data.cjs).
# - BACKUP_ENABLED=true  pour activer (recommandé en production)
# - BACKUP_DIR           dossier de destination des archives
#                        (défaut : <DATA_DIR>/backups → sur le Persistent Disk)
# - BACKUP_RETENTION_DAYS nombre de jours de conservation
# NOTE : la sauvegarde LOCALE ne protège PAS contre la perte complète
#        du Persistent Disk. Activez le stockage externe ci-dessous.
BACKUP_ENABLED=false
BACKUP_DIR=
BACKUP_RETENTION_DAYS=7

# --- Sauvegarde externe (Cloudflare R2 / S3 / B2) -------------
# Copie chaque archive vers un bucket S3-compatible (upload signé SigV4).
# Activer avec BACKUP_EXTERNAL=true puis renseigner les clés.
BACKUP_EXTERNAL=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=mangoo-backups
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Paiement -------------------------------------------------
# Mode de paiement. Par défaut « demo » : AUCUNE somme réelle
# n'est débitée, les opérateurs (Orange Money, Wave, MTN MoMo,
# Moov Money, Free Mobile) sont simulés. Ne passez à « live »
# qu'avec des clés API validées pour chaque opérateur.
PAYMENT_MODE=demo

# --- Wave Business (encaissement réel, Sénégal) ---------------
# En PAYMENT_MODE=live et avec WAVE_API_KEY renseignée, Wave est branché
# en réel (checkout redirect). Sans clé, Wave reste en démo.
WAVE_API_KEY=
# Base URL Wave (Sénégal par défaut). À pointer vers le sandbox ou un autre
# pays (CI, ML, BF…) si besoin.
WAVE_API_BASE=https://api.wave.com
# Secret de signature des webhooks entrants (fourni par Wave).
WAVE_WEBHOOK_SECRET=
# Secret de signature des requêtes (optionnel, si activé sur la clé).
WAVE_SIGNING_SECRET=

# --- Orange Money (Web Payment, redirect) ---------------------
# En PAYMENT_MODE=live et avec les 3 clés renseignées, Orange Money
# est branché en réel. Sans clé, Orange reste en démo.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
# Token de validation des notifications serveur→serveur (notif_url).
ORANGE_MONEY_NOTIF_TOKEN=
# Base URL Orange Money Web Payment (dev par défaut).
ORANGE_MONEY_API_BASE=https://api.orange.com/orange-money-webpay/dev/v1

# --- Notifications Web Push (VAPID) ---------------------------
# Permet de recevoir appels / messages / live même Dashboard fermé.
# Les clés VAPID sont GÉNÉRÉES AUTOMATIQUEMENT au premier démarrage
# et persistées dans DATA_DIR (data/vapid.json), donc stables entre
# redémarrages. Vous pouvez les fixer explicitement (recommandé en
# production pour ne jamais les perdre) :
#   node -e "require('web-push').generateVAPIDKeys()" puis coller
#   VAPID_PUBLIC_KEY  et  VAPID_PRIVATE_KEY  ci-dessous.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sujet VAPID (adresse de contact, exigée par certains navigateurs).
VAPID_SUBJECT=mailto:contact@mangootech.com

