{
  "version": "1.0.0",
  "name": "MangooTech Boutique DAN",
  "description": "Système de gestion de boutique avec charte graphique Mangoo",
  "features": {
    "sellerDashboard": true,
    "productManagement": true,
    "orderManagement": true,
    "sellerSettings": true,
    "shopLogo": true,
    "localStoragePersistence": true,
    "demoMode": true
  },
  "shopSettings": {
    "defaultShopName": "DAN",
    "defaultLogo": "https://trae-api-us.mchost.guru/api/ide/v1/text_to_image?prompt=Professional%20boutique%20logo%20with%20elegant%20typography%20and%20modern%20design%2C%20clean%20minimalist%20style%2C%20orange%20and%20green%20color%20scheme%2C%20high%20quality%20corporate%20branding&image_size=square_hd",
    "defaultBanner": "https://trae-api-us.mchost.guru/api/ide/v1/text_to_image?prompt=Premium%20boutique%20banner%20with%20gradient%20background%2C%20orange%20to%20green%20colors%2C%20elegant%20design%20elements%2C%20professional%20e-commerce%20style&image_size=landscape_16_9",
    "supportedFormats": ["png", "jpg", "jpeg", "gif", "webp", "svg"]
  },
  "ui": {
    "primaryColor": "#FF6F00",
    "secondaryColor": "#2E7D32",
    "gradientPrimary": "bg-gradient-primary",
    "gradientSecondary": "bg-gradient-secondary",
    "gradientHero": "bg-gradient-hero"
  },
  "debug": {
    "logging": true,
    "consoleOutput": true,
    "errorTracking": true
  }
}