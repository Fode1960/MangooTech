# ============================================================
#  Mangoo Connect+ — configuration de TEST (CI / smoke tests)
#  ------------------------------------------------------------
#  Valeurs NON sensibles, réservées aux environnements jetables
#  (intégration continue, tests automatisés). NE PAS utiliser en
#  production.
#
#  Le serveur lit uniquement le fichier `.env`. Pour lancer un
#  test :   cp .env.test .env   puis   node server.cjs
#  (ou injectez ces variables directement dans le runner CI).
# ============================================================

PORT=8080
HTTPS_PORT=8443

ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=TestPassword-123
ADMIN_PIN=1234

# Pas de certificat en CI : on désactive le forçage HTTPS pour
# pouvoir tester l'API admin en HTTP.
FORCE_HTTPS_ADMIN=false
