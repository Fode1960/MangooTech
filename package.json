    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "node-turn": "^0.0.6",
    "nodemailer": "^7.0.13",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
