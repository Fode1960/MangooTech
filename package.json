{
  "name": "mangootech-platform-complete",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "client:dev:3015": "vite --port 3015 --strictPort",
    "client:dev:3018": "vite --port 3018 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "server:dev": "nodemon",
    "webrtc:dev": "node api/servers/webrtc-websocket-server-3008.js",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\" \"npm run webrtc:dev\"",
    "dev:3015": "concurrently \"npm run client:dev:3015\" \"npm run server:dev\"",
    "dev:3018": "concurrently \"npm run client:dev:3018\" \"npm run server:dev\"",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/start-clean.ps1"
  },
