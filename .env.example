# Configuration Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Configuration PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox # ou "live" pour la production

# Configuration Frontend (Vite)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Configuration Mobile Money
ORANGE_MONEY_API_KEY=your_orange_money_api_key_here
ORANGE_MONEY_MERCHANT_CODE=your_orange_money_merchant_code_here

MTN_MOMO_API_KEY=your_mtn_momo_api_key_here
MTN_MOMO_MERCHANT_CODE=your_mtn_momo_merchant_code_here

MOOV_MONEY_API_KEY=your_moov_money_api_key_here
MOOV_MONEY_MERCHANT_CODE=your_moov_money_merchant_code_here

# Configuration Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

INTERNAL_MEET_ENABLED=1
INTERNAL_TEAM_EMAILS=alice@mangoo.tech,bob@mangoo.tech
VITE_INTERNAL_MEET=1

# Configuration générale
NODE_ENV=development
PORT=3009
